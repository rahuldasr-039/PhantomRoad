# =====================================================================
# PhantomRoad Environment Configuration (Optional Stage 4 AWS Settings)
# The application runs 100% locally by default without requiring AWS.
# =====================================================================

# Operational Storage Mode: 'local' (strict default, 0 AWS calls) or 'aws_s3'
PHANTOMROAD_STORAGE_MODE=local

# AWS S3 Configuration (Optional for cloud storage of videos and audit reports)
PHANTOMROAD_S3_BUCKET=phantomroad-vision-audit
PHANTOMROAD_AWS_REGION=us-east-1
PHANTOMROAD_S3_PREFIX=phantomroad/

# Enterprise Server-Side Encryption: 'AES256' (SSE-S3) or 'aws:kms'
PHANTOMROAD_S3_ENCRYPTION=AES256
PHANTOMROAD_KMS_KEY_ID=

# Optional IAM Role ARN to assume via AWS STS (recommended for cross-account or ECS)
PHANTOMROAD_AWS_ROLE_ARN=

# Optional Static AWS Credentials (leave blank if using IAM Roles or local mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Agent Configuration Defaults
PHANTOMROAD_MAX_ACTION_ATTEMPTS=3
PHANTOMROAD_ENABLE_LOCAL_MODELS=true
PHANTOMROAD_LOG_LEVEL=INFO
